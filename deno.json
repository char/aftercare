{
  "name": "@char/aftercare",
  "version": "0.7.0",
  "license": "WTFPL",
  "tasks": {
    "build-example": "deno run -A npm:vite@^8.3.1 build example --configLoader native"
  },
  "exports": {
    ".": "./lib/mod.ts",
    "./vite": "./lib/vite.ts",
    "./jsx-runtime": "./lib/jsx.ts",
    "./jsx-dev-runtime": "./lib/jsx.ts"
  },
  "compilerOptions": {
    "lib": ["deno.window", "dom"],
    "jsx": "react-jsx",
    "jsxImportSource": "@char/aftercare"
  },
  "publish": {
    "include": ["lib/", "README.md"]
  },
  "lint": {
    "rules": {
      "exclude": ["ban-types", "no-explicit-any", "no-import-prefix"]
    }
  }
}
